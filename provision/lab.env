# =============================================================================
#  lab.env — parâmetros centrais do homelab CORP.LAB
#  Todos os scripts de provisionamento leem este arquivo.
#  Mudou algo aqui? Atualize também docs/01-inventario.md.
# =============================================================================

# --- Domínio Active Directory -------------------------------------------------
LAB_DOMAIN="corp.lab"            # nome DNS do domínio
LAB_REALM="CORP.LAB"             # realm Kerberos (sempre MAIÚSCULO)
LAB_NETBIOS="CORP"               # nome NetBIOS / "pré-Windows 2000"
LAB_BASE_DN="DC=corp,DC=lab"

# --- Rede corporativa (rede interna do VirtualBox "corp-lan") ----------------
LAB_NET_CIDR="10.10.10.0/24"
LAB_NET_PREFIX="10.10.10"
LAB_NETMASK_BITS="24"
LAB_REVERSE_ZONE="10.10.10.in-addr.arpa"

DC01_IP="10.10.10.10"
FS01_IP="10.10.10.20"
MON01_IP="10.10.10.30"
PRINTER_IP="10.10.10.50"          # reserva DHCP de exemplo (impressora)
PRINTER_MAC="08:00:27:aa:00:50"

DHCP_POOL_START="10.10.10.100"
DHCP_POOL_END="10.10.10.199"
DHCP_LEASE_SECONDS="28800"        # 8 horas

# Interface da rede corporativa dentro das VMs. O Vagrantfile fixa o MAC da
# 2ª placa (LAN_MAC) e lib/common.sh descobre o nome real dela (ex.: enp0s8).
LAN_IF="${LAN_IF:-}"

# Encaminhador DNS para nomes da internet.
# 10.0.2.3 = DNS do NAT do VirtualBox (padrão nas VMs do Vagrant).
DNS_FORWARDER="${DNS_FORWARDER:-10.0.2.3}"

# --- Credenciais do LABORATÓRIO ----------------------------------------------
# Senhas de laboratório, públicas de propósito, para que qualquer pessoa
# reproduza o ambiente. NUNCA reutilize em produção.
LAB_ADMIN_PASSWORD="${LAB_ADMIN_PASSWORD:-Lab@Admin2026!}"
LAB_USER_PASSWORD="${LAB_USER_PASSWORD:-Lab@User2026!}"

# --- Plataforma ----------------------------------------------------------------
# "vagrant"   = VMs no VirtualBox (padrão, o laboratório de verdade)
# "container" = harness de teste em contêineres (tests/container-lab)
LAB_PLATFORM="${LAB_PLATFORM:-vagrant}"
LAB_ROOT="${LAB_ROOT:-/opt/homelab}"
TZ_NAME="America/Sao_Paulo"
